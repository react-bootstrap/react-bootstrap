{
  "compilerOptions": {
    "skipLibCheck": true,
    "declaration": true,
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": false
  },
  "include": ["."]
}
