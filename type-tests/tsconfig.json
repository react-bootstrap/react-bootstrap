{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": ["react"],
    "noEmit": true,
    "paths": {
      "react": ["../node_modules/@types/react"],
      "react/*": ["../node_modules/@types/react/*"]
    }
  },
  "include": ["*.tsx"]
}
