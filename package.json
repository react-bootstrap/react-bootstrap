{
  "name": "react-bootstrap",
  "version": "3.0.0-beta.6",
  "description": "Bootstrap 5 components built with React",
  "keywords": [
    "bootstrap",
    "react",
    "component",
    "components",
    "ecosystem-react",
    "react-component"
  ],
  "homepage": "https://react-bootstrap.github.io/",
  "bugs": {
    "url": "https://github.com/react-bootstrap/react-bootstrap/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Stephen J. Collings",
    "email": "stevoland@gmail.com"
  },
  "files": [
    "CHANGELOG.md",
    "lib",
    "cjs"
  ],
  "type": "module",
  "main": "cjs/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": {
        "types": "./cjs/index.d.ts",
        "default": "./cjs/index.js"
      },
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./cjs/*.d.ts",
        "default": "./cjs/*.js"
      },
      "import": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      }
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-bootstrap/react-bootstrap.git"
  },
  "scripts": {
    "bootstrap": "npm install && npm install --prefix www",
    "build": "rimraf lib && npm run build:esm && npm run build:esm:types && npm run build:cjs && npm run build:cjs:types",
    "build:esm": "babel src --out-dir lib --delete-dir-on-start --env-name esm --extensions .ts,.tsx --ignore '**/*.d.ts'",
    "build:cjs": "babel src --out-dir cjs --env-name cjs --delete-dir-on-start --extensions .ts,.tsx --ignore '**/*.d.ts' && echo '{\"type\": \"commonjs\"}' > cjs/package.json",
    "build:esm:types": "tsc --emitDeclarationOnly",
    "build:cjs:types": "tsc --emitDeclarationOnly --outDir cjs",
    "build-docs": "npm run build --prefix www",
    "check-types": "tsc -p ./test/tsconfig.json --noEmit",
    "deploy-docs": "npm run deploy --prefix www",
    "lint": "eslint src test",
    "prepublishOnly": "npm run build",
    "release": "rollout",
    "start": "npm run start --prefix www",
    "tdd": "vitest",
    "test": "npm run lint && npm run test-browser -- --browser=chromium",
    "test-browser": "vitest --run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --fix"
  },
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@restart/hooks": "^0.6.2",
    "@restart/ui": "^2.0.0-beta.10",
    "@types/react-transition-group": "^4.4.12",
    "clsx": "^2.1.1",
    "dom-helpers": "^6.0.1",
    "invariant": "^2.2.4",
    "react-transition-group": "^4.4.5",
    "uncontrollable": "^9.0.0",
    "warning": "^4.0.3"
  },
  "devDependencies": {
    "@4c/rollout": "^4.0.2",
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/register": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@react-bootstrap/babel-preset": "^2.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/invariant": "^2.2.37",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/warning": "^3.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@types/react": ">=18.3.12",
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "conventionalCommits": true
  }
}
